# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# local tooling and generated checks
/.idea/
/.site-starter/
/test-results/
.brooks-lint-history.json
*.tsbuildinfo

# test suites and test-only configuration
/tests/
*.test.ts
/playwright.config.ts
/vitest.config.ts

# local planning notes and personal documents
/*.md
/_gh_todo_*.txt
/CLAUDE.md
/main.py
/content/SOUND_EFFECTS_SOURCES.md
