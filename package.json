{
  "name": "interactive-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "cf:setup": "node tools/create-cloudflare-resources.mjs",
    "content:export": "node tools/export-media.mjs",
    "content:import": "node tools/import-media.mjs",
    "content:publish": "node tools/publish.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:all": "node tools/dev-all.mjs",
    "lint": "eslint src server functions tools tests vite.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs --max-warnings 0",
    "media:optimize": "node tools/optimize-media.mjs",
    "pretest:e2e": "npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "server": "node server/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p functions/tsconfig.json",
    "upload:assets": "node tools/upload-assets.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.46.4",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
