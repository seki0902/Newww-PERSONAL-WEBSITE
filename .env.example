# ---------- 本地开发（npm run dev:all / npm run dev:api）----------
# 本地 API 由 wrangler pages dev 提供，ADMIN_TOKEN 默认注入 dev-token
# （见 tools/dev-all.mjs 与 npm run dev:api）；要覆盖就先 export 再启动，或改 npm script。
ADMIN_TOKEN=dev-token
# 本地 KV 数据目录（wrangler --persist-to），内容用 npm run content:local 灌入
WRANGLER_PERSIST_TO=.wrangler/state

# ---------- 内容/素材上传与 Cloudflare 资源创建（npm run upload:assets / npm run cf:setup）----------
# API Token 权限：Account → Cloudflare Pages: Edit、Account → Workers KV Storage: Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
KV_NAMESPACE_ID=
