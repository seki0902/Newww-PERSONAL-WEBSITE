# ---------- 本地开发（npm run server / npm run dev:all）----------
# 本地 Postgres（示例：docker run -d --name seki-pg -e POSTGRES_USER=seki -e POSTGRES_PASSWORD=seki -e POSTGRES_DB=seki_portfolio -p 55432:5432 postgres:16-alpine）
DATABASE_URL=postgres://seki:seki@127.0.0.1:55432/seki_portfolio
PORT=8787
# 生产环境必须设置；留空则写接口只在非 production 环境下开放
ADMIN_TOKEN=

# ---------- 生产（/opt/seki-portfolio/.env，由 GitHub Actions 维护）----------
# APP_IMAGE=crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com/touhou-trpg/seki-portfolio:sha
# DATABASE_URL=postgres://seki:<密码>@touhou-trpg-db:5432/seki_portfolio
